{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:write-all",
    {
      "identifier": "fs:scope",
      "allow": ["$HOME/.config/omarchy/themes/**"]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://wallhaven.cc/*" },
        { "url": "https://*.wallhaven.cc/*" },
        { "url": "https://images.pexels.com/*" }
      ]
    }
  ]
}
