{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    // Third-party React prop types (shadcn, base-ui) aren't written for it.
    "exactOptionalPropertyTypes": false
  }
}
